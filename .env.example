# ---- Database ----
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/pcn-sportiva?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Leave COOKIE_DOMAIN blank for localhost; set to .pcnsportivalp.com in production
COOKIE_DOMAIN=

# ---- CORS (comma separated, no trailing slash) ----
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pcn-sportiva

# ---- Misc ----
NODE_ENV=development
PORT=4000
PUBLIC_SITE_URL=http://localhost:5173
